# Postgres connection (Neon, Vercel Postgres, Supabase — anything @vercel/postgres can speak)
POSTGRES_URL=

# Shared secret for /api/refresh. Vercel Cron sends this automatically as Bearer token.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Optional: override defaults from src/lib/config.ts without code changes
# CHILD_AGE_MONTHS=36
# HOME_LAT=37.3861
# HOME_LNG=-122.0839
